---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Waveform from '../components/Waveform.astro';
---
<Base title="Page not found · Shouvik Ahmed Antu" description="This page doesn't exist." path="/404">
  <Nav />
  <main id="main" class="container nf">
    <p class="label">00:00 / 00:00</p>
    <h1 class="nf-title">Nothing was said here.</h1>
    <Waveform count={40} seed={404} played={0} height={48} class="nf-wave" />
    <p>The page you're looking for doesn't exist or has moved.</p>
    <p><a href="/">Go to the homepage</a> or <a href="/ccsc.html">see the CCSC slides</a>.</p>
  </main>
</Base>

<style>
  .nf { padding-block: clamp(3rem, 10vw, 7rem); display: grid; gap: 1rem; max-width: 44rem; }
  .nf-title { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.25rem, 6vw, 4rem); line-height: 1; letter-spacing: -0.03em; }
  .nf-wave { max-width: 22rem; margin-block: 0.5rem; }
</style>
