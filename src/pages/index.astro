---
import Base from '../layouts/Base.astro';
import CaptionPlayer from '../components/CaptionPlayer.astro';
import { site } from '../site';
---
<Base title={`${site.name} · Conversational AI for learning`} description={site.description} path="/">
  <main id="main" class="container">
    <h1>{site.name}</h1>
    <CaptionPlayer parts={site.caption.parts} speaker={site.caption.speaker} />
  </main>
</Base>
