---
import Waveform from './Waveform.astro';
import { tokenize } from '../lib/caption';
import type { CaptionPart } from '../site';

interface Props { parts: CaptionPart[]; speaker: string; duration?: number; compact?: boolean; seed?: number }
const { parts, speaker, duration = 14, compact = false, seed = 3 } = Astro.props;

const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const tokens = tokenize(parts);
let html = '';
let open: string | undefined;
for (const t of tokens) {
  if (t.mark !== open) {
    if (open) html += '</mark>';
    if (t.spaceBefore) html += ' ';
    if (t.mark) html += `<mark class="hl-${t.mark}">`;
    open = t.mark;
  } else if (t.spaceBefore) {
    html += ' ';
  }
  html += `<span class="w">${escape(t.text)}</span>`;
}
if (open) html += '</mark>';

const clock = (s: number) => `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(Math.round(s % 60)).padStart(2, '0')}`;
---
<div class:list={['player', { compact }]} data-player data-duration={duration} data-seed={seed}>
  <div class="player-bar">
    <button type="button" class="player-btn" aria-label="Replay caption" hidden>
      <svg class="icon-play" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M4 2.5v11l9-5.5z" fill="currentColor" /></svg>
      <svg class="icon-pause" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M4 2.5h3v11H4zM9 2.5h3v11H9z" fill="currentColor" /></svg>
    </button>
    <div class="player-wave-wrap">
      <Waveform count={compact ? 60 : 140} seed={seed} played={1} height={72} class="player-static" />
      <canvas class="player-wave" aria-hidden="true"></canvas>
    </div>
    {!compact && <span class="player-time mono" aria-hidden="true"><span data-elapsed>00:00</span> / {clock(duration)}</span>}
  </div>
  <p class="speaker label">{speaker}</p>
  <p class="caption" set:html={html} />
</div>

<style>
  .player { display: grid; gap: 0.25rem; }
  .player-bar { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 1rem; margin-bottom: 1rem; }
  .player-btn {
    position: relative;
    width: 2.75rem; height: 2.75rem; border-radius: 50%; border: 0; cursor: pointer;
    display: grid; place-items: center; padding: 0;
    background: var(--accent); color: var(--btn-ink);
    box-shadow: 0 6px 18px -6px color-mix(in srgb, var(--accent) 70%, transparent);
    transition: transform 0.15s ease;
  }
  .player-btn:hover { transform: scale(1.07); }
  .player-btn:active { transform: scale(0.96); }
  .player-btn svg { grid-area: 1 / 1; }
  .icon-play { margin-left: 3px; }
  .icon-pause { display: none; }
  .is-playing .icon-play { display: none; }
  .is-playing .icon-pause { display: block; }
  .player-btn::before, .player-btn::after {
    content: ''; position: absolute; inset: 0; border-radius: 50%;
    border: 2px solid var(--accent); opacity: 0; pointer-events: none;
  }
  .is-playing .player-btn::before { animation: ring 1.8s ease-out infinite; }
  .is-playing .player-btn::after { animation: ring 1.8s ease-out 0.9s infinite; }
  @keyframes ring {
    from { transform: scale(1); opacity: 0.55; }
    to { transform: scale(1.9); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .player-btn::before, .player-btn::after { animation: none !important; }
  }
  .player-wave-wrap { display: grid; min-width: 0; }
  .player-wave-wrap > :global(*) { grid-area: 1 / 1; }
  .player-wave, .player-wave-wrap :global(.player-static) { width: 100%; height: 4.5rem; }
  .player-wave { visibility: hidden; }
  .player.ready .player-wave { visibility: visible; }
  .player.ready :global(.player-static) { visibility: hidden; }
  .player:not(.ready) .player-time { visibility: hidden; }
  .player:not(.ready) .player-bar { grid-template-columns: minmax(0, 1fr); }
  .player-time { font-size: 0.75rem; color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .caption { font-size: var(--step-caption); line-height: 1.45; max-width: 40ch; }
  .caption :global(.w) { transition: color 0.25s ease; }
  .caption :global(.w.dim) { color: color-mix(in srgb, var(--ink) 35%, var(--bg)); }
  .caption :global(mark .w.dim) { color: color-mix(in srgb, var(--mark-ink) 45%, transparent); }
  .compact .player-wave, .compact :global(.player-static) { height: 2.75rem; }
  .compact .player-btn { width: 2.25rem; height: 2.25rem; }
  .compact .caption { font-size: var(--step-1); max-width: 52ch; }
  @media (max-width: 560px) {
    .player-time { display: none; }
    .player-bar { grid-template-columns: auto minmax(0, 1fr); }
  }
</style>

<script>
  import { initPlayers } from '../scripts/player';
  initPlayers();
</script>
