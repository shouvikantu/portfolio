---
import { site } from '../site';

interface Props { title: string; description: string; path: string; ogImage?: string; noindex?: boolean }
const { title, description, path, ogImage = '/og.png', noindex = false } = Astro.props;
const base = Astro.site ?? new URL('https://www.shouvikantu.com');
const canonical = new URL(path, base).href;
const image = new URL(ogImage, base).href;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: base.href,
  email: `mailto:${site.email}`,
  jobTitle: 'AI researcher',
  affiliation: { '@type': 'CollegeOrUniversity', name: 'Universitat Pompeu Fabra' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Willamette University' },
    { '@type': 'CollegeOrUniversity', name: 'University of Birmingham' },
  ],
  knowsAbout: ['Conversational AI', 'AI in education', 'Large language models', 'Learning analytics', 'Voice interfaces'],
  sameAs: [site.links.github, site.links.linkedin],
};
---
<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<script type="application/ld+json" set:html={JSON.stringify(person)} />
