{
  "name": "shouvikantu-site",
  "type": "module",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "og": "node scripts/make-og.mjs",
    "test:unit": "vitest run tests/unit",
    "test:build": "vitest run tests/build.test.ts",
    "test:links": "linkinator dist --recurse --skip \"^https?://(?!localhost)\"",
    "test": "npm run test:unit && npm run build && npm run test:build && npm run test:links"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.5",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "astro": "7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "linkedom": "0.18.12",
    "linkinator": "8.1.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
