{
    "rewrites": [
        {
            "source": "/emai",
            "destination": "https://emai-seven.vercel.app/emai"
        },
        {
            "source": "/emai/(.*)",
            "destination": "https://emai-seven.vercel.app/emai/$1"
        }
    ],
    "headers": [
        {
            "source": "/slides/(.*)",
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex"
                }
            ]
        }
    ]
}
